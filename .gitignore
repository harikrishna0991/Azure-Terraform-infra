# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform variable files
*.tfvars
*.tfvars.json

# Allow non-secret development variables
!environments/dev/dev.tfvars

# SSH private keys
id_rsa
id_rsa.*
*.pem

# Environment and secret files
.env
.env.*
*.secret

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
